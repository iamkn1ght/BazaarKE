# Base URL used for checkout redirects and webhook callback registration.
# Set to your deployed domain in production (e.g. https://shop.example.com).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Sanity CMS — product catalog + order storage.
# Find projectId/dataset at https://www.sanity.io/manage -> your project.
# CHAMIA-SANITY-DATASET (signed 23 Jun 2026): canonical dataset is 'sanityyy' (matches app/lib/sanity.ts).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=sanityyy
NEXT_PUBLIC_SANITY_API_VERSION=2022-03-25
# Sanity write token — required for persisting orders (KP capture flow reuses sanity-write.ts).
# Create at sanity.io/manage -> API -> Tokens (Editor role).
SANITY_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# KMV rails. Secrets are delivered out-of-band (1Password) — never commit values.
# Per-rail secret ENCODING is fixed; the wrong encoding causes silent 401s.
# ─────────────────────────────────────────────────────────────────────────────

# Identiti — identity / KYC / phone tokens.  APP_SECRET encoding: hex-64.
# Webhooks are Kafka-only today (HTTP signer + IDENTITI_WEBHOOK_SECRET land at ID-14 Phase 2).
IDENTITI_API_BASE=https://identiti-production.up.railway.app
IDENTITI_APP_ID=unique_accessories_sandbox
IDENTITI_APP_SECRET=
# IDENTITI_WEBHOOK_SECRET=        # DEFERRED — Identiti is Kafka-only until ID-14

# Kipkiren Pay — payment rail (replaces PayPal).  APP_SECRET encoding: base64url-43 (NOT hex).
# AD-K06: name these PAYMENT_RAIL_* (rail-agnostic), never KIPKIREN_*. Base URL is env-var only.
# PAYMENT_RAIL_API_BASE is TBD — KP is not yet deployed (KP-1-Ops outstanding).
PAYMENT_RAIL_API_BASE=
PAYMENT_RAIL_APP_ID=unique_accessories_sandbox
PAYMENT_RAIL_APP_SECRET=
PAYMENT_RAIL_AUDIENCE=kipkiren_pay
# PAYMENT_RAIL_WEBHOOK_SECRET=    # DEFERRED — KP webhook is Kafka-only (no HTTP signer yet)

# Todoku — comms (SMS / WhatsApp / voice / in_app).  Secret encodings: base64url-43.
TODOKU_API_BASE=https://todoku-prod-production.up.railway.app
TODOKU_APP_ID=unique_accessories
TODOKU_APP_SECRET=
TODOKU_WEBHOOK_SECRET=

# Itafika — last-mile delivery (Week 4).  APP_SECRET encoding: hex-64.
# The SAME secret signs both directions — there is NO separate ITAFIKA_WEBHOOK_SECRET.
ITAFIKA_BASE_URL=https://itafika-production.up.railway.app
ITAFIKA_APP_ID=unique_accessories
ITAFIKA_APP_SECRET=

# Store dispatch origin — the pickup point Itafika quotes/dispatches FROM. Without LAT+LNG the
# delivery-fee quote returns "calculated at dispatch" and dispatchDelivery stays inert. Decimal
# degrees (example below is Nairobi CBD); LABEL is optional (defaults to "BazaarKE store").
ITAFIKA_ORIGIN_LAT=
ITAFIKA_ORIGIN_LNG=
ITAFIKA_ORIGIN_LABEL=BazaarKE store

# Helpan AI — agent runtime (Phase 2, INERT until provisioned). Shared base64 signer (prefix Helpan).
# UA is dual-role: a consumer (dispatches TO Helpan) AND a dispatch target (/api/agent/checkout +
# /api/webhooks/helpan). Nothing acts until `helpan-unique-accessories-v1` is registered and these
# land; every path fails CLOSED (delegated-authority gate) until then. Secret encoding confirmed at
# issuance. WEBHOOK_SECRET signs BOTH the inbound agent dispatch and the AUTHORITY_REVOKED webhook.
HELPAN_API_BASE=https://helpan-production.up.railway.app
HELPAN_APP_ID=unique_accessories
HELPAN_APP_SECRET=
HELPAN_WEBHOOK_SECRET=

# Hakken — cross-app discovery (Phase 2, INERT until provisioned). OUTBOUND-only; ISOLATED from the
# 4-rail signer (three-header pilot auth + an Identiti aud=hakken JWT). Doubly inert today: HAKKEN_*
# unset AND no aud=hakken JWT yet (getHakkenJwt defers → 503). Regulatory walls (no money keys, no
# PII; price_range_kes band only) are enforced app-side regardless. APP_SECRET encoding TBC at issuance.
HAKKEN_API_BASE=https://hakken-production.up.railway.app
HAKKEN_APP_KEY=unique_accessories
HAKKEN_APP_SECRET=
