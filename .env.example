# Base URL used for checkout redirects after PayPal approval.
# Set to your deployed domain in production (e.g. https://shop.example.com).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Sanity CMS — product catalog + order storage.
# Find projectId/dataset at https://www.sanity.io/manage → your project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2022-03-25

# PayPal — chosen payment provider.
# Get credentials at https://developer.paypal.com/dashboard/applications.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox: https://api-m.sandbox.paypal.com
# Live:    https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Register a webhook at https://developer.paypal.com → app → Webhooks.
# Point it at {NEXT_PUBLIC_BASE_URL}/api/paypal/webhook and subscribe to
# PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.REFUNDED, PAYMENT.CAPTURE.DENIED,
# CUSTOMER.DISPUTE.CREATED, CUSTOMER.DISPUTE.UPDATED.
PAYPAL_WEBHOOK_ID=

# Sanity write token — required for persisting orders after capture.
# Create at https://www.sanity.io/manage → your project → API → Tokens (Editor role).
SANITY_API_TOKEN=
